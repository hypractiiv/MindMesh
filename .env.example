# MindMesh Environment Configuration

# Database Engine Configuration
# Provide DATABASE_URL to use PostgreSQL (local Docker, Supabase, Neon, Render, etc.)
# If left commented or empty, MindMesh will automatically default to SQLite (mindmesh.db)
DATABASE_URL=postgresql://postgres:password@localhost:5432/mindmesh

# Optional: LLM Configuration for Dynamic Evaluation
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# MINDMESH_MODEL=google/gemini-2.0-flash-001
